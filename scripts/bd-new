#!/usr/bin/env bash
# Create a top-level Beads issue with the next sequential ID (acf-<N>).
#
# Usage: scripts/bd-new [bd create arguments...]
#   scripts/bd-new "Fix the thing" -t task -p 2 --description "..."
#
# Beads 1.3.1 only generates random IDs, so this wrapper picks the next free
# number from a full export and passes it with --id. Child issues created with
# --parent are passed straight through: Beads numbers them <parent>.<k>.
# If another agent takes the same number first, it retries with the next one.
set -euo pipefail

prefix="$(bd config get issue_prefix)"
prefix="${prefix%-}"

for arg in "$@"; do
  case "$arg" in
    --id|--id=*) echo "bd-new: do not pass --id; the wrapper assigns it" >&2; exit 2 ;;
    --parent|--parent=*) exec bd create "$@" ;;
  esac
done

next_number() {
  bd export --all | PREFIX="$prefix" python3 -c '
import json, os, re, sys
pat = re.compile(r"^" + re.escape(os.environ["PREFIX"]) + r"-(\d+)$")
top = 0
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    m = pat.match(json.loads(line).get("id", ""))
    if m:
        top = max(top, int(m.group(1)))
print(top + 1)
'
}

n="$(next_number)"
for _ in 1 2 3 4 5; do
  if out="$(bd create --id "${prefix}-${n}" "$@" 2>&1)"; then
    printf '%s\n' "$out"
    exit 0
  fi
  if ! grep -qiE 'already exists|duplicate|unique' <<<"$out"; then
    printf '%s\n' "$out" >&2
    exit 1
  fi
  n=$((n + 1))
done
echo "bd-new: could not claim a free ${prefix}-<N> after 5 attempts" >&2
exit 1
