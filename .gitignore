
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
# roborev snapshots
/.roborev/


# APM dependencies
apm_modules/

# Per-agent local state (settings, memory, caches) stays untracked. Commit only
# the APM-deployed agents and the skill links into .agents/skills/.
.claude/*
!.claude/skills/
!.claude/agents/
.opencode/*
!.opencode/agents/
